# Copy this file to ".env" and fill in your details.

# auto = live prices once an Angel One API is available, otherwise demo | demo = always simulated | angel = always live
DATA_MODE=auto

# ---- Admin login (opens the Admin dashboard). Set these in your own .env only; never commit real values.
ADMIN_USERNAME=choose-an-admin-username
ADMIN_PASSWORD=choose-a-strong-password

# ---- Optional: Angel One API for the shared live price feed. Leave empty: the admin picks a user's API instead.
# Each user adds their own API at sign-up for their balance, portfolio and trades. The app never places orders.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# ---- Supabase (optional; leave empty to save trades in data/trades.json)
SUPABASE_URL=
SUPABASE_KEY=

# ---- Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


TOP_VOLATILE_COUNT=200
PORT=8000
